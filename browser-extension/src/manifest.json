{
  "manifest_version": 3,
  "name": "Xbox Wishlist Manager",
  "version": "1.5.26272.4",
  "description": "Advanced filtering, sorting, and price tracking for Xbox wishlists",
  "author": "ZellReid",
  "homepage_url": "https://github.com/zellreid/xbox-wishlist",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.xbox.com/*/wishlist*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.xbox.com/*/wishlist*",
        "https://www.xbox.com/*/games/store/*",
        "https://www.xbox.com/*/games/browse*",
        "https://www.xbox.com/*/games/all-games*",
        "https://www.xbox.com/*/promotions/sales/*"
      ],
      "js": [ "shared/xbox-wishlist.core.js", "content.js" ],
      "css": [ "shared/styles.css" ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xbox.com/*/wishlist*",
        "https://www.xbox.com/*/games/store/*",
        "https://www.xbox.com/*/games/browse*",
        "https://www.xbox.com/*/games/all-games*",
        "https://www.xbox.com/*/promotions/sales/*"
      ],
      "js": [ "request-watcher.js" ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["shared/icons/*.svg", "shared/styles.css", "icons/*.png"],
      "matches": ["https://www.xbox.com/*"]
    }
  ],

  "action": {
    "default_title": "Xbox Wishlist Manager"
  }
}